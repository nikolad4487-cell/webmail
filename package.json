    "inbound:probe": "tsx scripts/inbound-probe.ts",
    "test:migration": "node --import tsx --test tests/migration/*.mjs",
    "test:identity": "node --import tsx --test tests/identity/*.mjs",
    "build:prisma": "npm run build && tsc -p tsconfig.server.json && node scripts/build-prisma.mjs",
    "test:passwords": "node --import tsx --test tests/passwords/*.mjs",
    "test:provisioning": "node --import tsx --test tests/provisioning/*.mjs",
    "test:formapoint": "node --import tsx --test tests/formapoint/flow.mjs",
    "test:welcome": "node --import tsx --test tests/formapoint/welcome.mjs",
    "test:schools": "node --import tsx --test tests/schools/*.mjs"
