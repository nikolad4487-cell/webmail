NODE_ENV=production
PORT=3000
APP_ORIGIN=https://webmailhr.com
ADMIN_ORIGIN=https://admin.webmailhr.com
TRUST_PROXY=1
DATABASE_URL=postgresql://WEBMAIL_DB_USER:SET_IN_SECRET_STORE@db.example.test:5432/webmail
# JSON keyed by mailbox or automation sender address. Supply real credentials via the secret store.
MAIL_ROUTES={}
MAIL_CAPACITY_BYTES=
MAILCOW_URL=
MAILCOW_API_KEY=
RECOVERY_SENDER=
INTEGRATION_KEYS=[]
UNSUBSCRIBE_SECRET=
# Set BOOTSTRAP_* only for the one-time bootstrap and remove afterwards.
BOOTSTRAP_ORG=
BOOTSTRAP_NAME=
BOOTSTRAP_EMAIL=admin@webmailhr.com
BOOTSTRAP_PASSWORD=
# BOOTSTRAP_RECOVERY is optional. Set only after independent address verification.
# ADMIN_EMAIL defaults to admin@webmailhr.com. Set ADMIN_PASSWORD only for npm run admin:password.
ADMIN_EMAIL=admin@webmailhr.com
ADMIN_PASSWORD=

# Random server-only pepper of at least 32 characters for staff PINs.
STAFF_PIN_PEPPER=

# Use the stable project ref and project base URL for each source.
EDNEVNIK_SUPABASE_PROJECT_ID=
EDNEVNIK_SUPABASE_URL=
EDNEVNIK_USERNAME_LOGIN_URL=https://e-ocjene.skolehr.xyz/api/auth/webmail/student
EDNEVNIK_USERNAME_LOGIN_TOKEN=
EDNEVNIK_LOGIN_DOMAINS=skolehr.xyz,eskole.me

FORMAPOINT_SUPABASE_PROJECT_ID=
FORMAPOINT_SUPABASE_URL=
FORMAPOINT_SUPABASE_AUTH_KEY=

# Optional bulk directory and personal mailbox provisioning (server/worker only).
EDNEVNIK_DIRECTORY_KEY=
EDNEVNIK_DIRECTORY_ORG=ŠkoleHR
EDNEVNIK_MAIL_DOMAIN=skolehr.xyz
FORMAPOINT_DIRECTORY_KEY=
FORMAPOINT_DIRECTORY_ORG=FormaPoint
FORMAPOINT_MAIL_DOMAIN=formapoint.online
MAILCOW_MAIL_HOST=
MAILBOX_ENCRYPTION_KEY=
# Temporary Production setting for a one-time Vercel sync: ednevnik, formapoint, or both.
WEBMAIL_DIRECTORY_SYNC=
