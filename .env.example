NODE_ENV=production
PORT=3000
APP_ORIGIN=https://webmailhr.com
ADMIN_ORIGIN=https://admin.webmailhr.com
TRUST_PROXY=1
DATABASE_URL=postgresql://WEBMAIL_DB_USER:SET_IN_SECRET_STORE@db.example.test:5432/webmail
# JSON keyed by mailbox or automation sender address. Supply real credentials via the secret store.
MAIL_ROUTES={}
MAIL_CAPACITY_BYTES=
MAILCOW_URL=
MAILCOW_API_KEY=
RECOVERY_SENDER=
INTEGRATION_KEYS=[]
UNSUBSCRIBE_SECRET=
# Set BOOTSTRAP_* only for the one-time bootstrap and remove afterwards.
BOOTSTRAP_ORG=
BOOTSTRAP_NAME=
BOOTSTRAP_EMAIL=admin@webmailhr.com
BOOTSTRAP_PASSWORD=
# BOOTSTRAP_RECOVERY is optional. Set only after independent address verification.
# ADMIN_EMAIL defaults to admin@webmailhr.com. Set ADMIN_PASSWORD only for npm run admin:password.
ADMIN_EMAIL=admin@webmailhr.com
ADMIN_PASSWORD=

# Legacy staff PINs only: keep the existing server-only pepper (at least 32 characters).
# New assigned/generated WebmailHR passwords do not require this setting.
STAFF_PIN_PEPPER=

# Use the stable project ref and project base URL for each source.
EDNEVNIK_SUPABASE_PROJECT_ID=
EDNEVNIK_SUPABASE_URL=
EDNEVNIK_USERNAME_LOGIN_URL=https://e-ocjene.skolehr.xyz/api/auth/webmail/student
EDNEVNIK_USERNAME_LOGIN_TOKEN=
EDNEVNIK_LOGIN_DOMAINS=skolehr.xyz,eskole.me

FORMAPOINT_SUPABASE_PROJECT_ID=
FORMAPOINT_SUPABASE_URL=
FORMAPOINT_SUPABASE_AUTH_KEY=

# Optional bulk directory and personal mailbox provisioning (server/worker only).
EDNEVNIK_DIRECTORY_KEY=
EDNEVNIK_DIRECTORY_ORG=ŠkoleHR
EDNEVNIK_MAIL_DOMAIN=skolehr.xyz
FORMAPOINT_DIRECTORY_KEY=
FORMAPOINT_DIRECTORY_ORG=FormaPoint
FORMAPOINT_MAIL_DOMAIN=formapoint.online
MAILCOW_MAIL_HOST=
MAILBOX_ENCRYPTION_KEY=
# Temporary Production setting for a one-time Vercel sync: ednevnik, formapoint, or both.
WEBMAIL_DIRECTORY_SYNC=

# Option 2 / no VPS pilot. Vercel server settings only (never VITE_*).
# Default allowlist is ONLY demo@skolehr.xyz. Does not enable a mailbox automatically.
# Add personal addresses comma-separated, then enable each mailbox as root in Admin.
# Cloudflare Worker ENABLED_RECIPIENTS and an Email Routing rule must match separately.
NATIVE_ENABLED_ADDRESSES=demo@skolehr.xyz
# Same random secret (at least 32 chars) as Cloudflare Worker INBOUND_SECRET.
CLOUDFLARE_INBOUND_SECRET=
# Conservative logical storage budgets, in bytes, across ALL native mailboxes.
NATIVE_MAILBOX_BYTES=25000000
NATIVE_TOTAL_BYTES=100000000
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
# 1 validates only; set 0 explicitly after sender verification to send real mail.
MAILJET_SANDBOX=1
# Counts all attempts and recipients (including sandbox/unknown outcomes), UTC periods.
MAILJET_DAILY_RECIPIENTS=100
MAILJET_MONTHLY_RECIPIENTS=1000
# Cloudflare Worker Settings -> Variables (NOT Vercel):
# INBOUND_URL=https://webmailhr.com/api/inbound/cloudflare
# ENABLED_RECIPIENTS=demo@skolehr.xyz
# Cloudflare Worker Settings -> Secrets: INBOUND_SECRET (same as above)
# Local automated tests only; use an EMPTY disposable database. Never production.
# TEST_DATABASE_URL=postgresql://webmail:local-native-only@127.0.0.1:55433/webmail_native_test
# MAILJET_TEST_URL is only honored in non-production DEMO_MODE=1, on 127.0.0.1.
